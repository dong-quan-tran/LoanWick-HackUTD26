# fixture (default) never calls NVIDIA. live never falls back to fixture.
AGENT_MODE=fixture

# Initial plan limit is 8 model turns. One tool call is executed per turn.
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_MS=30000

# Development-only private bytes. JSON, CSV, and text PDF intake write here.
# The directory is not served by the website. Unattached files older than 24 hours
# can be removed by the worker cleanup. Canonical fixtures are never deleted from here.
WORKER_UPLOAD_DIR=var/uploads

# Set the token to claim one queued job. Leave it unset to investigate the local demo case.
# SPACETIMEDB_URI=https://maincloud.spacetimedb.com
# SPACETIMEDB_DATABASE=loanwick-hackutd26-dev
# SPACETIMEDB_TOKEN=

# Used only when AGENT_MODE=live.
# Chat completions: https://docs.api.nvidia.com/nim/reference/nvidia-nemotron-3_5-bolt-e4b-infer
# Tool calling: https://docs.nvidia.com/nim/large-language-models/latest/function-calling.html
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=

# Required for live mode. Copy the model id from the NVIDIA sample for your key.
# The Nemotron omni reasoning sample uses nvidia/nemotron-3-nano-omni-30b-a3b-reasoning.
NVIDIA_MODEL=

# Optional request settings. Defaults are max_tokens 512 and temperature 0.
# The omni reasoning sample also sends top_p and reasoning_budget.
# NVIDIA_MAX_TOKENS=4096
# NVIDIA_TEMPERATURE=0.6
# NVIDIA_TOP_P=0.95
# NVIDIA_REASONING_BUDGET=2048
