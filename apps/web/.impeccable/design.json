  "narrative": {
    "northStar": "The Evidence Workspace",
    "overview": "LoanWick uses a narrow warm-brown rail, an ivory canvas, and compact white bordered panels for application scanning and evidence work. System UI text carries controls and headings; bundled Source Serif 4 gives portfolio totals a distinct numerical voice. Bronze amount bars, dusty-blue stages, clay concerns, and green Clear indicators carry meaning alongside written labels.\n\nThe existing espresso dossier cover is an explicit surface exception. Its serif statement, antique-gold framing, artwork, and Menu remain intact before the shared verification desk opens. The desk uses the same workspace materials as Applications. Existing generated rasters are reused with provenance; decorative paper never stands in for source evidence.",
    "keyCharacteristics": [
      "Warm-brown navigation and an ivory ground across role-appropriate workspaces.",
      "Compact white panels with fine warm borders and flat evidence surfaces.",
      "System UI headings and controls; Source Serif 4 totals and dossier statement.",
      "Text-backed semantic states, visible keyboard focus, and contained mobile overflow."
    ],
    "rules": [
      {
        "name": "The Literal Status Rule",
        "body": "Pair semantic color with a written status. A concern is an item for human investigation, never a fraud verdict.",
        "section": "colors"
      },
      {
        "name": "The Comparable Numbers Rule",
        "body": "Use tabular numerals for comparable totals, amounts, case metadata, facts, and revision summaries.",
        "section": "typography"
      },
      {
        "name": "The Cover Boundary Rule",
        "body": "Keep the dossier’s gold framing, engraved-banknote margins, and ceremonial entry treatment on its cover. Shared operating panels stay flat, white, and bordered.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do extend the shared warm-brown rail, ivory canvas, and white bordered panel language.",
      "Do pair stage and concern colors with literal text and preserve visible keyboard focus.",
      "Do preserve per-currency money, exact accessible totals, and source versions beside evidence.",
      "Do keep the cover exception scoped and the small folio inside upload.",
      "Do keep mobile filters usable, tables in contained scroll regions, and borrower fields legible."
    ],
    "donts": [
      "Don't reintroduce parchment double frames, overlapping gold loan pills, or floating banknotes into the operating desk.",
      "Don't use concern or Clear styling to imply fraud proof, lending approval, or server release authorization.",
      "Don't give ordinary panels ornamental shadows or use decorative imagery as evidence.",
      "Don't present fixture behavior, preliminary file checks, or a completed sample as live extraction or model verification."
    ]
  }
}
